doctype html
html
  head
    title Notificaciones

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light")

    // ======================
    // NAVBAR
    // ======================
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4

      .container-fluid

        a.navbar-brand(href="/publicaciones")
          | Fotaza

        .navbar-nav.ms-auto

          a.nav-link(href="/publicaciones")
            | Inicio

          a.nav-link(href="/feed")
            | Feed

          a.nav-link(href="/conversaciones")
            | Conversaciones

    // ======================
    // CONTENIDO
    // ======================
    .container

      .row.justify-content-center

        .col-lg-8

          h1.mb-4 Notificaciones

          if notificaciones.length > 0

            each n in notificaciones

              .card.shadow-sm.mb-3

                .card-body

                  // ======================
                  // MENSAJE
                  // ======================
                  h5.card-title

                    if n.UsuarioAccion

                      a(
                        href=`/perfil/${n.UsuarioAccion.id}`
                        class="text-decoration-none"
                      )
                        = n.UsuarioAccion.username

                      |  #{n.mensaje}

                    else

                      | Usuario desconocido #{n.mensaje}

                  // ======================
                  // TIPO
                  // ======================
                  if n.tipo == "comentario"

                    span.badge.bg-success.mb-2
                      | Comentario

                  if n.tipo == "valoracion"

                    span.badge.bg-warning.text-dark.mb-2
                      | Valoración

                  if n.tipo == "follow"

                    span.badge.bg-primary.mb-2
                      | Nuevo seguidor

                  if n.tipo == "interes"

                    span.badge.bg-info.text-dark.mb-2
                      | Interés en imagen

                  // ======================
                  // BOTÓN CHAT
                  // ======================
                  if n.conversacion_id

                    .mt-3

                      a.btn.btn-primary.btn-sm(
                        href=`/conversaciones/${n.conversacion_id}`
                      )
                        | Abrir conversación

                  // ======================
                  // FECHA
                  // ======================
                  p.text-muted.mb-0.mt-3

                    small
                      | #{n.fechaFormateada}

          else

            .alert.alert-secondary

              h4.mb-2 No tenés notificaciones

              p.mb-0
                | Cuando otros usuarios interactúen con vos,
                |  aparecerán acá.

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )