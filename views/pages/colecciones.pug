doctype html
html
  head
    title Colecciones

    meta(charset="UTF-8")

    meta(
      name="viewport"
      content="width=device-width, initial-scale=1"
    )

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light")

    // ======================
    // NAVBAR
    // ======================
    nav.navbar.navbar-dark.bg-dark.mb-4

      .container-fluid

        a.navbar-brand(
          href="/publicaciones"
        )
          | Fotaza

        .d-flex.gap-2

          a.btn.btn-outline-light(
            href="/publicaciones"
          )
            | Publicaciones

          a.btn.btn-outline-light(
            href="/conversaciones"
          )
            | Conversaciones

    // ======================
    // CONTENIDO
    // ======================
    .container

      .row.justify-content-center

        .col-lg-10

          h1.mb-4
            | Mis colecciones

          // ======================
          // FORM CREAR
          // ======================
          .card.shadow-sm.mb-4

            .card-body

              form(
                action="/colecciones"
                method="POST"
              )

                .row.g-2

                  .col-md-10

                    input.form-control(
                      type="text"
                      name="nombre"
                      placeholder="Nueva colección..."
                      required
                    )

                  .col-md-2

                    .d-grid

                      button.btn.btn-primary(
                        type="submit"
                      )
                        | Crear

          // ======================
          // LISTADO
          // ======================
          if colecciones.length == 0

            .alert.alert-secondary

              | Todavía no tenés colecciones

          else

            .row

              each c in colecciones

                .col-md-6.col-lg-4.mb-4

                  a.text-decoration-none.text-dark(
                    href=`/colecciones/${c.id}`
                  )

                    .card.shadow-sm.h-100

                      .card-body

                        h4.mb-3
                          = c.nombre

                        p.text-muted

                          | #{c.Publicacions.length}
                          |  publicaciones

                        if c.Publicacions.length > 0

                          if c.Publicacions[0].Imagens.length > 0

                            img.img-fluid.rounded.mb-3(
                              src=c.Publicacions[0].Imagens[0].url
                              style="height:220px; width:100%; object-fit:cover;"
                            )

                        else

                          .alert.alert-light
                            | Colección vacía

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )