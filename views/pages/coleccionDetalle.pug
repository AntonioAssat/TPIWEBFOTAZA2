doctype html
html
  head
    title Colección

    meta(charset="UTF-8")

    meta(
      name="viewport"
      content="width=device-width, initial-scale=1"
    )

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light")

    // ======================
    // NAVBAR
    // ======================
    nav.navbar.navbar-dark.bg-dark.mb-4

      .container-fluid

        a.navbar-brand(
          href="/colecciones"
        )
          | ← Colecciones

        a.btn.btn-outline-light(
          href="/publicaciones"
        )
          | Publicaciones

    // ======================
    // CONTENIDO
    // ======================
    .container

      h1.mb-4
        = coleccion.nombre

      if coleccion.Publicacions.length == 0

        .alert.alert-secondary

          | Esta colección no tiene publicaciones

      else

        each pub in coleccion.Publicacions

          .card.mb-4.shadow-sm

            .card-body

              h2.card-title.mb-3
                = pub.titulo

              if pub.Tags && pub.Tags.length > 0

                p

                  each tag in pub.Tags

                    span.badge.bg-primary.me-1
                      | ##{tag.nombre}

              if pub.User

                p.mb-3

                  strong Autor:
                  |  

                  a(
                    href=`/perfil/${pub.User.id}`
                    class="text-decoration-none"
                  )
                    = pub.User.username

              if pub.Imagens && pub.Imagens.length > 0

                each img in pub.Imagens

                  .border.rounded.p-3.mb-4.bg-white

                    .text-center.mb-3

                      img.img-fluid.rounded(
                        src=img.url
                        style="max-height:500px; object-fit:cover;"
                      )

                    p

                      strong Licencia:
                      |  #{img.licencia}

                    if img.Comentarios && img.Comentarios.length > 0

                      h5.mt-4 Comentarios

                      each c in img.Comentarios

                        .border-bottom.pb-2.mb-2

                          p.mb-1
                            = c.texto

                          small.text-muted
                            | por 
                            = c.User.username

                    h5.mt-4 Valoración

                    if img.Valoracions && img.Valoracions.length > 0

                      p

                        strong Promedio:
                        |  #{img.promedio} ⭐

                    else

                      p.text-muted
                        | Sin valoraciones

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )