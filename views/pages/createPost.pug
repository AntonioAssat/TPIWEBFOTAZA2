doctype html
html
  head
    title Nueva publicación

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light")

    // ======================
    // NAVBAR
    // ======================
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4

      .container-fluid

        a.navbar-brand(href="/publicaciones")
          | Fotaza

    // ======================
    // CONTENIDO
    // ======================
    .container

      .row.justify-content-center

        .col-md-8.col-lg-6

          .card.shadow-sm

            .card-body.p-4

              h1.text-center.mb-4
                | Crear publicación

              form(
                action="/publicaciones"
                method="POST"
                enctype="multipart/form-data"
              )

                // ======================
                // TÍTULO
                // ======================
                .mb-3

                  label.form-label(for="titulo")
                    | Título

                  input.form-control(
                    type="text"
                    name="titulo"
                    id="titulo"
                    required
                  )

                // ======================
                // DESCRIPCIÓN
                // ======================
                .mb-3

                  label.form-label(for="descripcion")
                    | Descripción

                  textarea.form-control(
                    name="descripcion"
                    id="descripcion"
                    rows="4"
                  )

                // ======================
                // TAGS
                // ======================
                .mb-3

                  label.form-label(for="tags")
                    | Etiquetas

                  input.form-control(
                    type="text"
                    name="tags"
                    id="tags"
                    placeholder="paisaje, noche, playa..."
                  )

                // ======================
                // LICENCIA
                // ======================
                .mb-3

                  label.form-label(for="licencia")
                    | Licencia

                  select.form-select(
                    name="licencia"
                    id="licencia"
                  )

                    option(value="publica")
                      | Pública

                    option(value="copyright")
                      | Copyright

                // ======================
                // WATERMARK
                // ======================
                .mb-3

                  label.form-label(for="watermark")
                    | Watermark

                  input.form-control(
                    type="text"
                    name="watermark"
                    id="watermark"
                    placeholder="Opcional"
                  )

                // ======================
                // IMÁGENES
                // ======================
                .mb-4

                  label.form-label(for="imagenes")
                    | Imágenes

                  input.form-control(
                    type="file"
                    name="imagenes"
                    id="imagenes"
                    accept="image/*"
                    multiple
                  )

                  .small.text-muted.mt-2
                    | Podés agregar imágenes una por una

                // ======================
                // PREVIEWS
                // ======================
                #previewContainer.row.mt-3.g-3

                // ======================
                // BOTÓN
                // ======================
                .d-grid.mt-4

                  button.btn.btn-primary.btn-lg(
                    type="submit"
                  )
                    | Publicar

    // ======================
    // SCRIPT IMÁGENES
    // ======================
    script.

      const inputImagenes =
          document.getElementById("imagenes");

      const previewContainer =
          document.getElementById("previewContainer");

      // acumulador real de archivos
      const dataTransfer = new DataTransfer();

      inputImagenes.addEventListener("change", (event) => {

          const file = event.target.files[0];

          if (!file) return;

          // agregar archivo
          dataTransfer.items.add(file);

          // actualizar files reales
          inputImagenes.files = dataTransfer.files;

          // ======================
          // CARD
          // ======================
          const col =
              document.createElement("div");

          col.className = "col-md-4";

          const card =
              document.createElement("div");

          card.className = "card shadow-sm";

          // ======================
          // IMAGEN
          // ======================
          const img =
              document.createElement("img");

          img.className = "card-img-top";

          img.style.height = "220px";

          img.style.objectFit = "cover";

          img.src = URL.createObjectURL(file);

          // ======================
          // BODY
          // ======================
          const body =
              document.createElement("div");

          body.className = "card-body";

          // nombre
          const name =
              document.createElement("p");

          name.className =
              "small text-muted";

          name.textContent = file.name;

          // botón eliminar
          const removeBtn =
              document.createElement("button");

          removeBtn.type = "button";

          removeBtn.className =
              "btn btn-danger btn-sm w-100";

          removeBtn.textContent = "Eliminar";

          // ======================
          // ELIMINAR
          // ======================
          removeBtn.addEventListener("click", () => {

              const newDataTransfer =
                  new DataTransfer();

              for (
                  let i = 0;
                  i < dataTransfer.files.length;
                  i++
              ) {

                  if (
                      dataTransfer.files[i].name !==
                      file.name
                  ) {

                      newDataTransfer.items.add(
                          dataTransfer.files[i]
                      );
                  }
              }

              // limpiar
              dataTransfer.items.clear();

              // reconstruir
              for (
                  let i = 0;
                  i < newDataTransfer.files.length;
                  i++
              ) {

                  dataTransfer.items.add(
                      newDataTransfer.files[i]
                  );
              }

              // actualizar input
              inputImagenes.files =
                  dataTransfer.files;

              // eliminar preview
              col.remove();
          });

          // ======================
          // ARMAR CARD
          // ======================
          body.appendChild(name);

          body.appendChild(removeBtn);

          card.appendChild(img);

          card.appendChild(body);

          col.appendChild(card);

          previewContainer.appendChild(col);

          

      });

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )