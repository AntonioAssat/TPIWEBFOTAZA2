doctype html
html
  head
    title Nueva publicación
  body
    h1 Crear publicación

    form(action="/publicaciones" method="POST")
      div
        label Título:
        input(type="text" name="titulo" required)

      div
        label Descripción:
        textarea(name="descripcion")
      div 
        label Etiquetas:
        input(type="text" name="tags")
      
      button(type="submit") Crear