doctype html
html
  head
    title Nueva publicación

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light")

    // ======================
    // NAVBAR
    // ======================
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4

      .container-fluid

        a.navbar-brand(href="/publicaciones")
          | Fotaza

    // ======================
    // CONTENIDO
    // ======================
    .container

      .row.justify-content-center

        .col-md-8.col-lg-6

          .card.shadow-sm

            .card-body.p-4

              h1.text-center.mb-4
                | Crear publicación

              form(
                action="/publicaciones"
                method="POST"
              )

                // ======================
                // TÍTULO
                // ======================
                .mb-3

                  label.form-label(for="titulo")
                    | Título

                  input.form-control(
                    type="text"
                    name="titulo"
                    id="titulo"
                    required
                  )

                // ======================
                // DESCRIPCIÓN
                // ======================
                .mb-3

                  label.form-label(for="descripcion")
                    | Descripción

                  textarea.form-control(
                    name="descripcion"
                    id="descripcion"
                    rows="4"
                  )

                // ======================
                // TAGS
                // ======================
                .mb-3

                  label.form-label(for="tags")
                    | Etiquetas

                  input.form-control(
                    type="text"
                    name="tags"
                    id="tags"
                    placeholder="paisaje, noche, playa..."
                  )

                // ======================
                // LICENCIA
                // ======================
                .mb-3

                  label.form-label(for="licencia")
                    | Licencia

                  select.form-select(
                    name="licencia"
                    id="licencia"
                  )

                    option(value="publica")
                      | Pública

                    option(value="copyright")
                      | Copyright

                // ======================
                // WATERMARK
                // ======================
                .mb-3

                  label.form-label(for="watermark")
                    | Watermark

                  input.form-control(
                    type="text"
                    name="watermark"
                    id="watermark"
                    placeholder="Ej: Fotaza / Antonio"
                  )

                  .form-text
                    | La marca de agua se incrusta automáticamente en la imagen

                // ======================
                // IMÁGENES
                // ======================
                .mb-4

                  label.form-label(for="imagenes")
                    | Imágenes

                  input.form-control(
                    type="file"
                    id="imagenes"
                    accept="image/*"
                    multiple
                  )

                  .small.text-muted.mt-2
                    | Las imágenes se comprimen automáticamente

                // ======================
                // INPUTS HIDDEN
                // ======================
                #hiddenInputs

                // ======================
                // PREVIEWS
                // ======================
                #previewContainer.row.mt-3.g-3

                // ======================
                // BOTÓN
                // ======================
                .d-grid.mt-4

                  button.btn.btn-primary.btn-lg(
                    type="submit"
                  )
                    | Publicar

    // ======================
    // SCRIPT IMÁGENES
    // ======================
    script.

      const inputImagenes =
        document.getElementById(
          "imagenes"
        );

      const previewContainer =
        document.getElementById(
          "previewContainer"
        );

      const hiddenInputs =
        document.getElementById(
          "hiddenInputs"
        );

      inputImagenes.addEventListener(
        "change",
        async (event) => {

          const files =
            Array.from(
              event.target.files
            );

          for (const file of files) {

            const reader =
              new FileReader();

            reader.onload = (e) => {

              const img =
                new Image();

              img.src =
                e.target.result;

              img.onload = () => {

                const canvas =
                  document.createElement(
                    "canvas"
                  );

                const MAX_WIDTH = 1200;

                let width =
                  img.width;

                let height =
                  img.height;

                if (
                  width > MAX_WIDTH
                ) {

                  height =
                    height *
                    (MAX_WIDTH / width);

                  width =
                    MAX_WIDTH;
                }

                canvas.width =
                  width;

                canvas.height =
                  height;

                const ctx =
                  canvas.getContext(
                    "2d"
                  );

                // ======================
                // DIBUJAR IMAGEN
                // ======================
                ctx.drawImage(
                  img,
                  0,
                  0,
                  width,
                  height
                );

                // ======================
                // WATERMARK REAL
                // ======================
                const watermark =
                  document.getElementById(
                    "watermark"
                  ).value;

                if (
                  watermark.trim() !== ""
                ) {

                  ctx.save();

                  // centro
                  ctx.translate(
                    canvas.width / 2,
                    canvas.height / 2
                  );

                  // diagonal
                  ctx.rotate(
                    -Math.PI / 6
                  );

                  // estilo
                  ctx.font =
                    "bold 52px Arial";

                  ctx.fillStyle =
                    "rgba(255,255,255,0.22)";

                  ctx.textAlign =
                    "center";

                  ctx.textBaseline =
                    "middle";

                  ctx.fillText(
                    `© ${watermark}`,
                    0,
                    0
                  );

                  ctx.restore();
                }

                // ======================
                // COMPRESIÓN
                // ======================
                const compressed =
                  canvas.toDataURL(
                    "image/jpeg",
                    0.7
                  );

                // ======================
                // HIDDEN INPUT
                // ======================
                const hidden =
                  document.createElement(
                    "input"
                  );

                hidden.type =
                  "hidden";

                hidden.name =
                  "imagenesBase64";

                hidden.value =
                  compressed;

                hiddenInputs.appendChild(
                  hidden
                );

                // ======================
                // PREVIEW
                // ======================
                const col =
                  document.createElement(
                    "div"
                  );

                col.className =
                  "col-md-4";

                const card =
                  document.createElement(
                    "div"
                  );

                card.className =
                  "card shadow-sm";

                const previewImg =
                  document.createElement(
                    "img"
                  );

                previewImg.src =
                  compressed;

                previewImg.className =
                  "card-img-top";

                previewImg.style.height =
                  "220px";

                previewImg.style.objectFit =
                  "cover";

                const body =
                  document.createElement(
                    "div"
                  );

                body.className =
                  "card-body";

                const name =
                  document.createElement(
                    "p"
                  );

                name.className =
                  "small text-muted";

                name.textContent =
                  file.name;

                // ======================
                // BOTÓN ELIMINAR
                // ======================
                const removeBtn =
                  document.createElement(
                    "button"
                  );

                removeBtn.type =
                  "button";

                removeBtn.className =
                  "btn btn-danger btn-sm w-100";

                removeBtn.textContent =
                  "Eliminar";

                removeBtn.addEventListener(
                  "click",
                  () => {

                    hidden.remove();

                    col.remove();
                  }
                );

                body.appendChild(
                  name
                );

                body.appendChild(
                  removeBtn
                );

                card.appendChild(
                  previewImg
                );

                card.appendChild(
                  body
                );

                col.appendChild(
                  card
                );

                previewContainer.appendChild(
                  col
                );
              };
            };

            reader.readAsDataURL(
              file
            );
          }

          inputImagenes.value = "";
        }
      );

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )