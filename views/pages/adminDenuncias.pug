doctype html
html
  head
    title Panel denuncias

    meta(charset="UTF-8")

    meta(
      name="viewport"
      content="width=device-width, initial-scale=1"
    )

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light")

    nav.navbar.navbar-dark.bg-dark.mb-4

      .container-fluid

        a.navbar-brand(
          href="/publicaciones"
        )
          | Panel administrador

    .container

      h1.mb-4
        | Denuncias

      if denuncias.length == 0

        .alert.alert-secondary

          | No hay denuncias

      else

        each d in denuncias

          .card.shadow-sm.mb-4

            .card-body

              if d.Imagen

                img.img-fluid.rounded.mb-3(
                  src=d.Imagen.url
                  style="max-height:300px;"
                )

              h5
                | Motivo:
                |  #{d.motivo}

              p
                strong Descripción:
                |  #{d.descripcion}

              if d.User

                p.text-muted
                  | Denunciado por:
                  |  #{d.User.username}

              if d.Imagen

                p

                  strong Estado:
                  |  #{d.Imagen.estado}

                .mt-3.d-flex.gap-2

                    form(
                        action=`/admin/imagenes/${d.Imagen.id}/aprobar`
                        method="POST"
                    )

                        button.btn.btn-success(
                        type="submit"
                        )
                        | Aprobar imagen

                    form(
                        action=`/admin/imagenes/${d.Imagen.id}/eliminar`
                        method="POST"
                    )

                        button.btn.btn-danger(
                        type="submit"
                        )
                        | Eliminar imagen