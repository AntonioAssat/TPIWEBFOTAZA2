doctype html
html
  head
    title Conversaciones

    meta(charset="UTF-8")

    meta(
      name="viewport"
      content="width=device-width, initial-scale=1"
    )

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light")

    // ======================
    // NAVBAR
    // ======================
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4

      .container-fluid

        a.navbar-brand(
          href="/publicaciones"
        )
          | Fotaza

        .d-flex.gap-2

          a.btn.btn-outline-light(
            href="/publicaciones"
          )
            | Publicaciones

          a.btn.btn-outline-light(
            href="/notificaciones"
          )
            | Notificaciones

    // ======================
    // CONTENIDO
    // ======================
    .container

      h1.mb-4
        | Conversaciones

      // ======================
      // SIN CONVERSACIONES
      // ======================
      if conversaciones.length == 0

        .alert.alert-secondary

          | No tenés conversaciones todavía

      else

        // ======================
        // LISTADO
        // ======================
        each c in conversaciones

          .card.shadow-sm.mb-3

            .card-body

              .row.align-items-center

                // ======================
                // INFO
                // ======================
                .col-md-9

                  h5.mb-2

                    if usuario.id == c.autor_id

                      | Conversación con 
                      = c.Comprador.username

                    else

                      | Conversación con 
                      = c.Autor.username

                  p.mb-1.text-muted

                    | Imagen relacionada

                  if c.Imagen

                    img.rounded(
                      src=c.Imagen.url
                      width="120"
                    )

                // ======================
                // BOTÓN
                // ======================
                .col-md-3.text-md-end.mt-3.mt-md-0

                  a.btn.btn-primary(
                    href=`/conversaciones/${c.id}`
                  )
                    | Abrir chat

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )