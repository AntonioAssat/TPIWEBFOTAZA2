doctype html
html
  head
    title Historial de moderación

    meta(charset="UTF-8")

    meta(
      name="viewport"
      content="width=device-width, initial-scale=1"
    )

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light")

    nav.navbar.navbar-dark.bg-dark.mb-4

      .container-fluid

        a.navbar-brand(
          href="/publicaciones"
        )
          | ← Volver

    .container

      h1.mb-4
        | 🗑 Historial de moderación

      .mb-4

            a.btn.btn-outline-primary(
                href="/admin/denuncias"
            )
                | 🚨 Ver denuncias
      if imagenes.length == 0

        .alert.alert-secondary

          | No hay imágenes eliminadas

      else

        each img in imagenes

          .card.shadow-sm.mb-4

            .card-body

              img.img-fluid.rounded.mb-3(
                src=img.url
                style="max-height:300px;"
              )

              if img.Publicacion

                h5.mb-3
                  = img.Publicacion.titulo

                if img.Publicacion.User

                  p.text-muted

                    strong Autor:
                    |  #{img.Publicacion.User.username}

              p

                strong Estado:
                |  #{img.estado}

              .mt-3

                form(
                  action=`/admin/imagenes/${img.id}/aprobar`
                  method="POST"
                )

                  button.btn.btn-success(
                    type="submit"
                  )
                    | ♻ Restaurar imagen