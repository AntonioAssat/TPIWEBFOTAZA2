doctype html
html
  head
    title Chat

    meta(charset="UTF-8")

    meta(
      name="viewport"
      content="width=device-width, initial-scale=1"
    )

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light")

    // ======================
    // NAVBAR
    // ======================
    nav.navbar.navbar-dark.bg-dark.mb-4

      .container-fluid

        a.navbar-brand(
          href="/conversaciones"
        )
          | ← Conversaciones

        a.btn.btn-outline-light(
          href="/publicaciones"
        )
          | Publicaciones
    // ======================
    // CONTENIDO
    // ======================
    .container

      .row.justify-content-center

        .col-lg-8

          .card.shadow-sm

            .card-body

              // ======================
              // HEADER
              // ======================
              .d-flex.align-items-center.justify-content-between.mb-4

                div

                  if usuario.id == conversacion.autor_id

                    h4.mb-1
                      | Chat con 
                      = conversacion.Comprador.username

                  else

                    h4.mb-1
                      | Chat con 
                      = conversacion.Autor.username

                  p.text-muted.mb-0
                    | Conversación sobre una imagen

                if conversacion.Imagen

                  img.rounded(
                    src=conversacion.Imagen.url
                    width="120"
                  )

              hr

              // ======================
              // MENSAJES
              // ======================
              .mb-4(
                style="max-height:500px; overflow-y:auto;"
              )

                if conversacion.Mensajes.length == 0

                  p.text-muted
                    | Todavía no hay mensajes

                else

                  each m in conversacion.Mensajes

                    if m.emisor_id == usuario.id

                      .d-flex.justify-content-end.mb-3

                        .bg-primary.text-white.p-3.rounded(
                          style="max-width:70%;"
                        )

                          p.mb-1
                            = m.texto

                          small
                            = m.Emisor.username

                    else

                      .d-flex.justify-content-start.mb-3

                        .bg-light.border.p-3.rounded(
                          style="max-width:70%;"
                        )

                          p.mb-1
                            = m.texto

                          small.text-muted
                            = m.Emisor.username

              // ======================
              // FORM
              // ======================
              form(
                action=`/conversaciones/${conversacion.id}/mensaje`
                method="POST"
              )

                .input-group

                  input.form-control(
                    type="text"
                    name="texto"
                    placeholder="Escribí un mensaje..."
                    required
                  )

                  button.btn.btn-primary(
                    type="submit"
                  )
                    | Enviar

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )