doctype html
html
  head
    title Editar Perfil

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light")

    // ======================
    // NAVBAR
    // ======================
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4

      .container-fluid

        a.navbar-brand(href="/publicaciones")
          | Fotaza

        .navbar-nav.ms-auto

          a.nav-link(href=`/perfil/${usuario.id}`)
            | Volver al perfil

    // ======================
    // CONTENIDO
    // ======================
    .container

      .row.justify-content-center

        .col-md-8.col-lg-6

          .card.shadow-sm

            .card-body.p-4

              h1.text-center.mb-4
                | Editar Perfil

              form(
                action=`/perfil/${usuario.id}/editar`
                method="POST"
              )

                // ======================
                // AVATAR ACTUAL
                // ======================
                .text-center.mb-4

                  if usuario.avatar

                    img#previewAvatar.rounded-circle.shadow(
                      src=usuario.avatar
                      width="180"
                      height="180"
                      style="object-fit:cover;"
                    )

                  else

                    img#previewAvatar.rounded-circle.shadow(
                      src="https://via.placeholder.com/180"
                      width="180"
                      height="180"
                    )

                // ======================
                // USERNAME
                // ======================
                .mb-3

                  label.form-label(for="username")
                    | Usuario

                  input.form-control(
                    type="text"
                    name="username"
                    id="username"
                    value=usuario.username
                    required
                  )

                // ======================
                // FECHA NACIMIENTO
                // ======================
                .mb-3

                  label.form-label(for="fechaNacimiento")
                    | Fecha de nacimiento

                  input.form-control(
                    type="date"
                    name="fechaNacimiento"
                    id="fechaNacimiento"
                    value=usuario.fechaNacimiento
                  )

                // ======================
                // FOTO PERFIL
                // ======================
                .mb-3

                  label.form-label(for="avatarInput")
                    | Foto de perfil

                  input.form-control(
                    type="file"
                    id="avatarInput"
                    accept="image/*"
                  )

                  input(
                    type="hidden"
                    name="avatarBase64"
                    id="avatarBase64"
                  )

                  .form-text
                    | La imagen se comprimirá automáticamente

                // ======================
                // BIO
                // ======================
                .mb-3

                  label.form-label(for="bio")
                    | Bio

                  textarea.form-control(
                    name="bio"
                    id="bio"
                    rows="4"
                  )= usuario.bio

                // ======================
                // PASSWORD
                // ======================
                hr

                h4.mb-3
                  | Cambiar contraseña

                .mb-3

                  label.form-label(for="password")
                    | Nueva contraseña

                  input.form-control(
                    type="password"
                    name="password"
                    id="password"
                    placeholder="Nueva contraseña"
                  )

                .mb-4

                  label.form-label(for="confirmPassword")
                    | Confirmar contraseña

                  input.form-control(
                    type="password"
                    name="confirmPassword"
                    id="confirmPassword"
                    placeholder="Repetí la contraseña"
                  )

                // ======================
                // BOTÓN
                // ======================
                .d-grid

                  button.btn.btn-primary.btn-lg(
                    type="submit"
                  )
                    | Guardar cambios

    // ======================
    // COMPRESIÓN + BASE64
    // ======================
    script.

      const avatarInput =
        document.getElementById(
          "avatarInput"
        );

      const avatarBase64 =
        document.getElementById(
          "avatarBase64"
        );

      const preview =
        document.getElementById(
          "previewAvatar"
        );

      avatarInput.addEventListener(
        "change",
        (e) => {

          const file =
            e.target.files[0];

          if (!file) return;

          const reader =
            new FileReader();

          reader.onload = (event) => {

            const img = new Image();

            img.src =
              event.target.result;

            img.onload = () => {

              const canvas =
                document.createElement(
                  "canvas"
                );

              const MAX_WIDTH = 800;

              let width =
                img.width;

              let height =
                img.height;

              // ======================
              // REDIMENSIONAR
              // ======================
              if (width > MAX_WIDTH) {

                height =
                  height *
                  (MAX_WIDTH / width);

                width = MAX_WIDTH;
              }

              canvas.width = width;

              canvas.height = height;

              const ctx =
                canvas.getContext("2d");

              ctx.drawImage(
                img,
                0,
                0,
                width,
                height
              );

              // ======================
              // COMPRESIÓN
              // ======================
              const compressed =
                canvas.toDataURL(
                  "image/jpeg",
                  0.7
                );

              // guardar base64
              avatarBase64.value =
                compressed;

              // preview
              preview.src =
                compressed;
            };
          };

          reader.readAsDataURL(file);
        }
      );

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )