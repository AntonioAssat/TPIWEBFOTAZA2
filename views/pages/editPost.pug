doctype html
html
  head
    title Editar publicación

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light")

    // ======================
    // NAVBAR
    // ======================
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4

      .container-fluid

        a.navbar-brand(href="/publicaciones")
          | Fotaza

    // ======================
    // CONTENIDO
    // ======================
    .container

      .row.justify-content-center

        .col-md-8.col-lg-7

          // ======================
          // MENSAJE
          // ======================
          if mensaje

            .alert.alert-warning.shadow-sm
              = mensaje

          .card.shadow-sm.border-0

            .card-body.p-4

              h1.text-center.mb-4
                | Editar publicación

              if error

                .alert.alert-danger

                  = error
                  
              form(
                action=`/publicaciones/${publicacion.id}/editar`
                method="POST"
              )

                // ======================
                // TÍTULO
                // ======================
                .mb-3

                  label.form-label(for="titulo")
                    | Título

                  input.form-control(
                    type="text"
                    name="titulo"
                    id="titulo"
                    value=publicacion.titulo
                    required
                  )

                // ======================
                // DESCRIPCIÓN
                // ======================
                .mb-3

                  label.form-label(for="descripcion")
                    | Descripción

                  textarea.form-control(
                    name="descripcion"
                    id="descripcion"
                    rows="4"
                  )= publicacion.descripcion

                // ======================
                // TAGS
                // ======================
                .mb-4

                  label.form-label(for="tags")
                    | Etiquetas

                  input.form-control(
                    type="text"
                    name="tags"
                    id="tags"
                    value=tagsString
                    placeholder="paisaje, noche, playa..."
                  )

                  .form-text
                    | Separá las etiquetas con comas

                // ======================
                // IMÁGENES ACTUALES
                // ======================
                if publicacion.Imagens && publicacion.Imagens.length > 0

                  h4.mb-3
                    | Imágenes actuales

                  .row.g-3.mb-4

                    each img in publicacion.Imagens

                      .col-md-6

                        .card.shadow-sm.border-0

                          img.card-img-top(
                            src=img.url
                            style="height:250px; object-fit:cover;"
                          )

                          .card-body

                            p.mb-2

                              strong Estado:
                              |  #{img.estado}

                            p.mb-0

                              strong Licencia:
                              |  #{img.licencia}

                // ======================
                // INFO
                // ======================
                .alert.alert-info

                  strong
                    | Importante:
                  br
                  | Editar la publicación no modifica las imágenes ni elimina comentarios o valoraciones.

                // ======================
                // BOTONES
                // ======================
                .d-flex.justify-content-between.mt-4

                  a.btn.btn-outline-secondary(
                    href=`/perfil/${publicacion.usuario_id}`
                  )
                    | Cancelar

                  button.btn.btn-primary(
                    type="submit"
                  )
                    | Guardar cambios

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )