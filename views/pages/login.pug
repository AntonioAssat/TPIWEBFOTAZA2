doctype html
html
  head
    title Login

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(
    class="bg-light d-flex align-items-center justify-content-center"
    style="min-height:100vh;"
  )

    .container

      .row.justify-content-center

        .col-md-6.col-lg-4

          .card.shadow-lg.border-0

            .card-body.p-4

              // ======================
              // TÍTULO
              // ======================
              .text-center.mb-4

                h1.fw-bold Fotaza

                p.text-muted
                  | Iniciá sesión para continuar

              // ======================
              // ALERTA REGISTRO
              // ======================
              if registro == "ok"

                .alert.alert-success

                  | Usuario registrado correctamente.
                  |  Ya podés iniciar sesión.
              
              if error 
                .alert.alert-danger
                  = error 
              // ======================
              // MENSAJE
              // ======================
              if mensaje

                .alert.alert-warning
                  = mensaje

              // ======================
              // FORM LOGIN
              // ======================
              form(
                action="/login"
                method="POST"
                id="loginForm"
                novalidate
              )

                // ======================
                // EMAIL
                // ======================
                .mb-3

                  label.form-label(
                    for="email"
                  )
                    | Email

                  input.form-control(
                    type="email"
                    name="email"
                    id="email"
                    required
                  )

                  .invalid-feedback
                    | Ingresá un email válido

                // ======================
                // PASSWORD
                // ======================
                .mb-4

                  label.form-label(
                    for="password"
                  )
                    | Contraseña

                  input.form-control(
                    type="password"
                    name="password"
                    id="password"
                    minlength="4"
                    required
                  )

                  .invalid-feedback
                    | La contraseña debe tener al menos 4 caracteres

                // ======================
                // BOTÓN
                // ======================
                .d-grid

                  button.btn.btn-dark.btn-lg(
                    type="submit"
                  )
                    | Iniciar sesión

              // ======================
              // REGISTRO
              // ======================
              .text-center.mt-4

                p.mb-1.text-muted
                  | ¿No tenés cuenta?

                a.text-decoration-none(
                  href="/registro"
                )
                  | Registrate acá

    // ======================
    // VALIDACIONES JS
    // ======================
    script.

      const form =
        document.getElementById(
          "loginForm"
        );

      const email =
        document.getElementById(
          "email"
        );

      const password =
        document.getElementById(
          "password"
        );

      // ======================
      // VALIDAR EMAIL
      // ======================
      function validarEmail() {

        const regex =
          /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (
          !regex.test(
            email.value.trim()
          )
        ) {

          email.classList.add(
            "is-invalid"
          );

          email.classList.remove(
            "is-valid"
          );

          return false;
        }

        email.classList.remove(
          "is-invalid"
        );

        email.classList.add(
          "is-valid"
        );

        return true;
      }

      // ======================
      // VALIDAR PASSWORD
      // ======================
      function validarPassword() {

        if (
          password.value.trim().length < 4
        ) {

          password.classList.add(
            "is-invalid"
          );

          password.classList.remove(
            "is-valid"
          );

          return false;
        }

        password.classList.remove(
          "is-invalid"
        );

        password.classList.add(
          "is-valid"
        );

        return true;
      }

      // ======================
      // EVENTOS
      // ======================
      email.addEventListener(
        "input",
        validarEmail
      );

      password.addEventListener(
        "input",
        validarPassword
      );

      // ======================
      // SUBMIT
      // ======================
      form.addEventListener(
        "submit",
        (e) => {

          const emailOk =
            validarEmail();

          const passwordOk =
            validarPassword();

          if (
            !emailOk ||
            !passwordOk
          ) {

            e.preventDefault();
          }
        }
      );

    script(
      src="/js/loginValidations.js"
    )
    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )