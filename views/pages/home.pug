doctype html
html
  head
    title Fotaza

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light")

    // ======================
    // NAVBAR
    // ======================
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark

      .container-fluid

        a.navbar-brand(href="/")
          | Fotaza

        .navbar-nav.ms-auto

          a.nav-link(href="/login")
            | Login

          a.nav-link(href="/registro")
            | Registro

    // ======================
    // HERO
    // ======================
    .container.py-5

      .row.align-items-center

        .col-lg-6

          h1.display-4.fw-bold.mb-4
            | Compartí tus mejores fotos

          p.lead.text-muted.mb-4
            | Fotaza es una plataforma para publicar,
            | comentar y descubrir imágenes de otros usuarios.

          .d-flex.gap-3

            a.btn.btn-dark.btn-lg(
              href="/login"
            )
              | Iniciar sesión

            a.btn.btn-outline-dark.btn-lg(
              href="/registro"
            )
              | Registrarse

        .col-lg-6.text-center

          img.img-fluid.rounded.shadow(
            src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=1200"
          )

    // ======================
    // EXPLORAR
    // ======================
    .container.pb-5.text-center

      h2.mb-4
        | Explorá publicaciones públicas

      p.text-muted.mb-4
        | Los usuarios anónimos pueden visualizar
        | contenido público sin iniciar sesión.

      a.btn.btn-primary.btn-lg(
        href="/publicaciones"
      )
        | Ver publicaciones

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )