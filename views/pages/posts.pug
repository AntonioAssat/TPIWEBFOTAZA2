doctype html
html
  head
    title Publicaciones

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light")

    // ======================
    // NAVBAR
    // ======================
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4

      .container-fluid

        a.navbar-brand(href="/publicaciones")
          | Fotaza

        button.navbar-toggler(
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        )

          span.navbar-toggler-icon

        #navbarNav.collapse.navbar-collapse

          ul.navbar-nav.me-auto

            li.nav-item

              a.nav-link(href="/feed")
                | Feed

            li.nav-item

              a.nav-link(href="/publicaciones/nueva")
                | Nueva publicación

            li.nav-item

              a.nav-link(href="/notificaciones")
                | Notificaciones

            li.nav-item

              a.nav-link(href="/conversaciones")
                | Conversaciones

          if usuario

            ul.navbar-nav

              li.nav-item

                a.nav-link(href=`/perfil/${usuario.id}`)
                  | Mi perfil

              li.nav-item

                a.nav-link.text-danger(href="/logout")
                  | Cerrar sesión

    // ======================
    // CONTENIDO
    // ======================
    .container

      h1.mb-4 Publicaciones

      // ======================
      // MENSAJE
      // ======================
      if mensaje

        .alert.alert-success
          = mensaje

      // ======================
      // BUSCADOR
      // ======================
      form(
        action="/publicaciones"
        method="GET"
        class="mb-4"
      )

        .input-group

          input.form-control(
            type="text"
            name="search"
            placeholder="Buscar publicaciones o tags..."
          )

          button.btn.btn-primary(type="submit")
            | Buscar

      // ======================
      // LISTADO
      // ======================
      each pub in publicaciones

        .card.mb-4.shadow-sm

          .card-body

            // ======================
            // TÍTULO
            // ======================
            h2.card-title.mb-3
              = pub.titulo

            // ======================
            // TAGS
            // ======================
            if pub.Tags && pub.Tags.length > 0

              p

                each tag in pub.Tags

                  span.badge.bg-primary.me-1
                    | ##{tag.nombre}

            // ======================
            // AUTOR
            // ======================
            if pub.User

              p.mb-3

                strong Autor:
                |  

                a(
                  href=`/perfil/${pub.User.id}`
                  class="text-decoration-none"
                )
                  = pub.User.username

            else

              p Autor: Sin usuario

            // ======================
            // CARRUSEL
            // ======================
            if pub.Imagens && pub.Imagens.length > 0

              .carousel.slide.mb-3(
                id=`carousel-${pub.id}`
                data-bs-ride="false"
              )

                // ======================
                // INDICADORES
                // ======================
                .carousel-indicators

                  each img, index in pub.Imagens

                    button(
                      type="button"
                      data-bs-target=`#carousel-${pub.id}`
                      data-bs-slide-to=index
                      class=index == 0 ? "active" : ""
                    )

                // ======================
                // ITEMS
                // ======================
                .carousel-inner

                  each img, index in pub.Imagens

                    .carousel-item(
                      class=index == 0 ? "active" : ""
                    )

                      .border.rounded.p-3.bg-white

                        // ======================
                        // IMAGEN
                        // ======================
                        .text-center.mb-3

                          img.img-fluid.rounded(
                            src=img.url
                            style="max-height:500px; object-fit:cover;"
                          )

                        // ======================
                        // DATOS
                        // ======================
                        p

                          strong Licencia:
                          |  #{img.licencia}

                        p

                          strong Estado:
                          |  #{img.estado}

                        if img.watermark

                          p

                            strong Watermark:
                            |  #{img.watermark}

                        // ======================
                        // BLOQUEO
                        // ======================
                        if img.estado == "en_revision"

                          .alert.alert-danger
                            | ⚠ Imagen en revisión (interacciones bloqueadas)

                        else

                          // ======================
                          // COMENTARIOS
                          // ======================
                          h4.mt-4 Comentarios

                          if img.Comentarios && img.Comentarios.length > 0

                            each c in img.Comentarios

                              .border-bottom.pb-2.mb-2

                                p.mb-1
                                  = c.texto

                                small.text-muted
                                  | por 
                                  = c.User.username

                          else

                            p.text-muted
                              | Sin comentarios

                          if usuario

                            form(
                              action=`/imagenes/${img.id}/comentario`
                              method="POST"
                              class="mb-4"
                            )

                              .input-group

                                input.form-control(
                                  type="text"
                                  name="texto"
                                  placeholder="Escribí un comentario"
                                  required
                                )

                                button.btn.btn-success(
                                  type="submit"
                                )
                                  | Comentar

                          else

                            p.text-muted
                              | Tenés que iniciar sesión para comentar

                          // ======================
                          // VALORACIONES
                          // ======================
                          h4 Valoración

                          if img.Valoracions && img.Valoracions.length > 0

                            p

                              strong Promedio:
                              |  #{img.promedio} ⭐ (
                              = img.Valoracions.length
                              |  votos)

                          else

                            p.text-muted
                              | Sin valoraciones

                          if usuario

                            form(
                              action=`/imagenes/${img.id}/valorar`
                              method="POST"
                              class="mb-4"
                            )

                              .row.g-2

                                .col-auto

                                  select.form-select(
                                    name="valor"
                                  )

                                    option(value="1") 1
                                    option(value="2") 2
                                    option(value="3") 3
                                    option(value="4") 4
                                    option(value="5") 5

                                .col-auto

                                  button.btn.btn-warning(
                                    type="submit"
                                  )
                                    | Valorar

                          else

                            p.text-muted
                              | Tenés que iniciar sesión para valorar
                          
                          // ME INTERESA
                          if img.licencia== "copyright"
                          
                            
                            h4 Me interesa

                            p.text-muted
                              | Esta imagen posee copyright y puede adquirirse contactando al autor.


                            if usuario

                              form(
                                action=`/imagenes/${img.id}/interes`
                                method="POST"
                                class="mb-4"
                              )

                               button(type="submit")
                                | ❤️ Me interesa
                        
                            else

                             p.text-muted
                               | Tenés que iniciar sesión para mostrar interés
                          else

                          
                            .alert.alert-light.border
                              | Esta imagen es de dominio público y puede ser utilizada libremente.
                          // ======================
                          // DENUNCIAS
                          // ======================
                          h4 Denunciar

                          if usuario

                            form(
                              action=`/imagenes/${img.id}/denunciar`
                              method="POST"
                            )

                              .mb-2

                                select.form-select(
                                  name="motivo"
                                )

                                  option(
                                    value="Contenido inapropiado"
                                  )
                                    | Contenido inapropiado

                                  option(
                                    value="Derechos de autor"
                                  )
                                    | Derechos de autor

                                  option(value="Spam")
                                    | Spam

                              .mb-2

                                input.form-control(
                                  type="text"
                                  name="descripcion"
                                  placeholder="Explicá el motivo"
                                )

                              button.btn.btn-danger(
                                type="submit"
                              )
                                | Denunciar

                          else

                            p.text-muted
                              | Tenés que iniciar sesión para denunciar

                // ======================
                // BOTONES ABAJO
                // ======================
                .mt-3.d-flex.justify-content-center.gap-3

                  button.btn.btn-outline-dark(
                    type="button"
                    data-bs-target=`#carousel-${pub.id}`
                    data-bs-slide="prev"
                  )
                    | ← Anterior

                  button.btn.btn-outline-dark(
                    type="button"
                    data-bs-target=`#carousel-${pub.id}`
                    data-bs-slide="next"
                  )
                    | Siguiente →

            else

              p.text-muted
                | No hay imágenes

    // ======================
    // BOTÓN FLOTANTE
    // ======================
    a.btn.btn-primary.rounded-circle.shadow-lg(
      href="/publicaciones/nueva"
      style="position:fixed; bottom:30px; right:30px; width:70px; height:70px; font-size:35px; display:flex; align-items:center; justify-content:center; z-index:999;"
    )
      | +

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )