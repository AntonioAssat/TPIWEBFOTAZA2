doctype html
html
  head
    title Publicaciones
  body
    h1 Publicaciones

    each pub in publicaciones
      div(style="border:1px solid black; margin:10px; padding:10px;")
        h2= pub.titulo
        p= pub.descripcion

        if pub.imagenes.length > 0
          each img in pub.imagenes
            div
              img(src=img.url width="200")

              p Licencia: #{img.licencia}

              if img.watermark
                p Watermark: #{img.watermark}
        else
          p No hay imágenes