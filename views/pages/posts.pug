doctype html
html
  head
    title Publicaciones
  body
    h1 Publicaciones

    // MENSAJE
    if mensaje
      p(style="background:lightgreen; padding:10px; border:1px solid green;")
        = mensaje

    // ======================
    // BUSCADOR
    // ======================
    form(action="/publicaciones" method="GET")
      input(type="text" name="search" placeholder="Buscar publicaciones...")
      button(type="submit") Buscar

    // ======================
    // LISTADO
    // ======================
    each pub in publicaciones
      div(style="border:1px solid black; margin:10px; padding:10px;")
        
        h2= pub.titulo
        p Autor: #{pub.User ? pub.User.username : "Sin usuario"}

        // ======================
        // IMÁGENES
        // ======================
        if pub.Imagens && pub.Imagens.length > 0
          each img in pub.Imagens
            div(style="margin-top:10px; padding:10px; border:1px dashed gray;")
              
              img(src=img.url width="200")

              p Licencia: #{img.licencia}

              if img.watermark
                p Watermark: #{img.watermark}

              // ======================
              // COMENTARIOS
              // ======================
              h4 Comentarios

              if img.Comentarios && img.Comentarios.length > 0
                each c in img.Comentarios
                  p #{c.texto} (#{c.User.username})
              else
                p Sin comentarios

              if usuario
                form(action=`/imagenes/${img.id}/comentario` method="POST")
                  input(type="text" name="texto" placeholder="Escribí un comentario" required)
                  button(type="submit") Comentar
              else
                p Tenés que iniciar sesión para comentar

              // ======================
              // VALORACIONES
              // ======================
              h4 Valoración

              if img.Valoracions && img.Valoracions.length > 0
                p Promedio: #{img.promedio} ⭐ (#{img.Valoracions.length} votos)
              else
                p Sin valoraciones

              if usuario
                form(action=`/imagenes/${img.id}/valorar` method="POST")
                  select(name="valor")
                    option(value="1") 1
                    option(value="2") 2
                    option(value="3") 3
                    option(value="4") 4
                    option(value="5") 5
                  button(type="submit") Valorar
              else
                p Tenés que iniciar sesión para valorar

              // ======================
              // DENUNCIAS
              // ======================
              h4 Denunciar

              if usuario
                form(action=`/imagenes/${img.id}/denunciar` method="POST")
                  select(name="motivo")
                    option(value="Contenido inapropiado") Contenido inapropiado
                    option(value="Derechos de autor") Derechos de autor
                    option(value="Spam") Spam
                  input(type="text" name="descripcion" placeholder="Explicá el motivo")
                  button(type="submit") Denunciar
              else
                p Tenés que iniciar sesión para denunciar

        else
          p No hay imágenes