doctype html
html
  head
    title Publicaciones

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )
    link(
      rel="stylesheet"
      href="/css/style.css"
    )

  body(class="bg-light")

    // ======================
    // NAVBAR
    // ======================
    nav.navbar.navbar-expand-lg.navbar-dark.custom-navbar.mb-4.sticky-top.shadow

      .container-fluid

        a.navbar-brand.fw-bold.fs-3(href="/publicaciones")
          | 📸 Fotaza

        button.navbar-toggler(
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        )

          span.navbar-toggler-icon

        #navbarNav.collapse.navbar-collapse

          ul.navbar-nav.me-auto
            
            li.nav-item

              a.nav-link(href="/publicaciones")
                | 🏠 Inicio

            li.nav-item

              a.nav-link(href="/feed")
                | 📰Feed

            li.nav-item

              a.nav-link(href="/publicaciones/nueva")
                | ➕Publicar

            li.nav-item

              a.nav-link(href="/conversaciones")
                | 💬Conversaciones

            li.nav-item

              a.nav-link(href="/colecciones")
                | ⭐Colecciones
            
            if usuario && usuario.rol == "admin"

              li.nav-item.ms-2

                a.btn.btn-warning.btn-sm(
                  href="/admin/denuncias"
                )
                  | 🛡️ Admin
          if usuario

            ul.navbar-nav

              li.nav-item.dropdown

                a.nav-link.dropdown-toggle.d-flex.align-items-center.gap-2(
                  href="#"
                  role="button"
                  data-bs-toggle="dropdown"
                )

                  img.rounded-circle(
                    src=usuario.avatar
                    width="35"
                    height="35"
                    style="object-fit:cover;"
                  )

                  span= usuario.username

                ul.dropdown-menu.dropdown-menu-end.shadow

                  li

                    a.dropdown-item(
                      href=`/perfil/${usuario.id}`
                    )
                      | Mi perfil

                  li

                    a.dropdown-item(
                      href="/notificaciones"
                    )
                      | Notificaciones

                  li

                    hr.dropdown-divider

                  li

                    a.dropdown-item.text-danger(
                      href="/logout"
                    )
                      | Cerrar sesión

    // ======================
    // CONTENIDO
    // ======================
    .container

      h1.display-5.fw-bold.mb-4
        | 📸 Publicaciones


      if error

        .alert.alert-danger

          = error
      // ======================
      // MENSAJE
      // ======================
      if mensaje

        .alert.alert-success
          = mensaje

      // ======================
      // BUSCADOR
      // ======================
      button.btn.btn-primary.buscador-flotante(
        type="button"
        data-bs-toggle="modal"
        data-bs-target="#buscadorModal"
      )
        span.icono 🔍

        span.texto-busqueda Buscar Publicaciones 

      // ======================
      // LISTADO
      // ======================
      each pub in publicaciones

        .card.mb-5.shadow.border-0

          .card-body.p-4
            if pub.User

              .d-flex.align-items-center.mb-3

                img.rounded-circle.me-2(
                  src=pub.User.avatar || "/img/default.png"
                  width="45"
                  height="45"
                  style="object-fit:cover;"
                )

                div

                  a(
                    href=`/perfil/${pub.User.id}`
                    class="text-decoration-none fw-bold"
                  )
                    = pub.User.username

                  br

                  small.text-muted
                    | 📅 #{pub.fecha.toLocaleDateString("es-AR")}

            h2.card-title.mb-3
              = pub.titulo

            // ======================
            // TAGS
            // ======================
            if pub.Tags && pub.Tags.length > 0

              p

                each tag in pub.Tags

                  span.badge.bg-primary.me-1
                    | ##{tag.nombre}

            // ======================
            // AUTOR
            // ======================

            // ======================
            // GUARDAR EN COLECCIÓN
            // ======================
            if usuario && colecciones && colecciones.length > 0

              .card.bg-light.border-0.mb-3

                .card-body.p-3

                  form(
                    action=`/publicaciones/${pub.id}/guardar`
                    method="POST"
                  )

                    .row.g-2.align-items-end

                      .col-md-8

                        label.form-label(
                          for=`coleccion-${pub.id}`
                        )
                          | Guardar en colección

                        select.form-select(
                          name="coleccion_id"
                          id=`coleccion-${pub.id}`
                          required
                        )


                            option(
                              value=""
                              disabled
                              selected
                              hidden
                            )
                              | Elegí una colección

                            each c in colecciones

                              option(value=c.id)
                                = c.nombre

                      .col-md-4

                        .d-grid

                          button.btn.btn-outline-primary(
                            type="submit"
                          )
                            | ⭐ Guardar

            // ======================
            // CARRUSEL
            // ======================
            if pub.Imagens && pub.Imagens.length > 0

              .carousel.slide.mb-3(
                id=`carousel-${pub.id}`
                data-bs-ride="false"
              )

                // ======================
                // INDICADORES
                // ======================
                .carousel-indicators

                  each img, index in pub.Imagens

                    button(
                      type="button"
                      data-bs-target=`#carousel-${pub.id}`
                      data-bs-slide-to=index
                      class=index == 0 ? "active" : ""
                    )

                // ======================
                // ITEMS
                // ======================
                .carousel-inner

                  each img, index in pub.Imagens

                    .carousel-item(
                      class=index == 0 ? "active" : ""
                    )

                      .border.rounded.p-3.bg-white

                        // ======================
                        // IMAGEN
                        // ======================
                        .text-center.mb-3.position-relative

                          img.img-fluid.rounded(
                            src=img.url
                            style="max-height:500px; object-fit:cover;"
                          )

                          if img.watermark

                            .position-absolute.top-50.start-50.translate-middle

                              span(style="background:rgba(0,0,0,0.35); color:white; padding:10px 20px; border-radius:10px; font-size:28px; font-weight:bold; transform:rotate(-20deg); display:inline-block;")
                                = img.watermark

                        // ======================
                        // DATOS
                        // ======================
                        p

                          strong Licencia:
                          |  #{img.licencia}

                        p

                          strong Estado:
                          |  #{img.estado}

                        // ======================
                        // BLOQUEO
                        // ======================
                        if img.estaEnRevision

                          .alert.alert-danger
                            | ⚠ Imagen en revisión (interacciones bloqueadas)

                        else

                          // ======================
                          // COMENTARIOS
                          // ======================
                          h4.mt-4 Comentarios

                          if img.esAutor

                            .mb-3

                              if img.puedeCerrarComentarios

                                form(
                                  action=`/imagenes/${img.id}/cerrar-comentarios`
                                  method="POST"
                                  onsubmit="return confirm('¿Cerrar comentarios de esta imagen?')"
                                )

                                  button.btn.btn-outline-danger.btn-sm(
                                    type="submit"
                                  )
                                    | 🔒 Cerrar comentarios

                              if img.puedeAbrirComentarios

                                form(
                                  action=`/imagenes/${img.id}/abrir-comentarios`
                                  method="POST"
                                  onsubmit="return confirm('¿Reabrir comentarios de esta imagen?')"
                                )

                                  button.btn.btn-outline-success.btn-sm(
                                    type="submit"
                                  )
                                    | 🔓 Reabrir comentarios

                          if img.comentarios_cerrados

                            .alert.alert-warning.py-2
                              | 🔒 Los comentarios fueron cerrados por el autor 

                          // ======================
                          // LISTA COMENTARIOS
                          // ======================
                          if img.tieneComentarios

                            each c in img.Comentarios

                              .border-bottom.pb-3.mb-3

                                p.mb-1
                                  = c.texto

                                small.text-muted
                                  | por 
                                  = c.User.username

                                // ======================
                                // DENUNCIAS VISIBLES AL AUTOR
                                // ======================
                                if usuario && pub.User && usuario.id == pub.User.id

                                  if c.DenunciaComentarios && c.DenunciaComentarios.length > 0

                                    .alert.alert-danger.mt-3

                                      h6.mb-3
                                        | 🚨 Comentario denunciado

                                      p.mb-2

                                        strong
                                          | Cantidad de denuncias:
                                        |  #{c.DenunciaComentarios.length}

                                      each d in c.DenunciaComentarios

                                        .card.mb-2.border-danger

                                          .card-body.py-2

                                            p.mb-1

                                              strong Motivo:
                                              |  #{d.motivo}

                                            p.mb-1

                                              strong Descripción:
                                              |  #{d.descripcion}

                                            small.text-muted

                                              | denunciado por 
                                              = d.User.username

                                  form(
                                        action=`/comentarios/${c.id}/eliminar`
                                        method="POST"
                                        class="mt-3"
                                        onsubmit="return confirm('¿Eliminar comentario denunciado?')"
                                      )

                                    button.btn.btn-danger.btn-sm(
                                      type="submit"
                                        )
                                         | 🗑 Eliminar comentario  

                                // ======================
                                // DENUNCIAR COMENTARIO
                                // ======================
                                if c.puedeDenunciar

                                  form(
                                    action=`/comentarios/${c.id}/denunciar`
                                    method="POST"
                                    class="mt-3"
                                  )

                                    .row.g-2

                                      .col-md-4

                                        label.form-label.small.mb-1
                                          | Motivo

                                        select.form-select.form-select-sm(
                                          name="motivo"
                                          required
                                        )

                                          option(value="")
                                            | Seleccionar motivo

                                          option(value="Insulto")
                                            | Insulto

                                          option(value="Spam")
                                            | Spam

                                          option(value="Contenido ofensivo")
                                            | Contenido ofensivo

                                      .col-md-5

                                        label.form-label.small.mb-1
                                          | Descripción

                                        textarea.form-control.form-control-sm(
                                          name="descripcion"
                                          rows="2"
                                          minlength="5"
                                          maxlength="200"
                                          required
                                        )

                                      .col-md-3.d-flex.align-items-end

                                        .d-grid.w-100

                                          button.btn.btn-outline-danger.btn-sm(
                                            type="submit"
                                          )
                                            | 🚨 Denunciar

                          else

                            p.text-muted
                              | Sin comentarios

                          // ======================
                          // FORM COMENTAR
                          // ======================
                          if usuario

                            if img.puedeComentar

                              form(
                                action=`/imagenes/${img.id}/comentario`
                                method="POST"
                                class="mb-4"
                              )

                                .mb-3

                                  label.form-label(
                                    for=`comentario-${img.id}`
                                  )
                                    | Escribir comentario

                                  textarea.form-control(
                                    name="texto"
                                    id=`comentario-${img.id}`
                                    rows="2"
                                    minlength="2"
                                    maxlength="300"
                                    required
                                  )

                                  .form-text
                                    | Máximo 300 caracteres

                                button.btn.btn-success(
                                  type="submit"
                                )
                                  | Comentar

                            else

                              p.text-muted
                                | Los comentarios están cerrados

                          else

                            p.text-muted
                              | Tenés que iniciar sesión para comentar

                          // ======================
                          // VALORACIONES
                          // ======================
                          h4 Valoración

                          if img.tieneValoraciones

                            p

                              strong Promedio:
                              |  #{img.promedio} ⭐ (
                              = img.Valoracions.length
                              |  votos)

                          else

                            p.text-muted
                              | Sin valoraciones

                          if img.usuarioLogueado

                            if img.puedeValorar

                              form(
                                action=`/imagenes/${img.id}/valorar`
                                method="POST"
                                class="mb-4"
                              )

                                .row.g-2.align-items-end

                                  .col-md-4

                                    label.form-label(
                                      for=`valor-${img.id}`
                                    )
                                      | Puntaje

                                    select.form-select(
                                      name="valor"
                                      id=`valor-${img.id}`
                                      required
                                    )

                                      option(value="")
                                        | Seleccionar

                                      option(value="1") 1
                                      option(value="2") 2
                                      option(value="3") 3
                                      option(value="4") 4
                                      option(value="5") 5

                                  .col-md-4

                                    button.btn.btn-warning.w-100(
                                      type="submit"
                                    )
                                      | Valorar

                            else

                              p.text-muted
                                | No podés valorar tus propias imágenes

                          else

                            p.text-muted
                              | Tenés que iniciar sesión para valorar

                          // ======================
                          // ME INTERESA
                          // ======================
                          if img.esCopyright

                            h4 Me interesa

                            p.text-muted
                              | Esta imagen posee copyright y puede adquirirse contactando al autor.

                            if usuario

                              form(
                                action=`/imagenes/${img.id}/interes`
                                method="POST"
                                class="mb-4"
                              )

                                button.btn.btn-info(
                                  type="submit"
                                )
                                  | ❤️ Me interesa

                            else

                              p.text-muted
                                | Tenés que iniciar sesión para mostrar interés

                          else

                            .alert.alert-light.border
                              | Esta imagen es de dominio público y puede ser utilizada libremente.

                          // ======================
                          // DENUNCIAS
                          // ======================
                          h4 Denunciar imagen

                          if img.puedeDenunciarImagen

                            form(
                              action=`/imagenes/${img.id}/denunciar`
                              method="POST"
                            )

                              .mb-3

                                label.form-label(
                                  for=`motivo-img-${img.id}`
                                )
                                  | Motivo

                                select.form-select(
                                  name="motivo"
                                  id=`motivo-img-${img.id}`
                                  required
                                )

                                  option(value="")
                                    | Seleccionar motivo

                                  option(
                                    value="Contenido inapropiado"
                                  )
                                    | Contenido inapropiado

                                  option(
                                    value="Derechos de autor"
                                  )
                                    | Derechos de autor

                                  option(value="Spam")
                                    | Spam

                              .mb-3

                                label.form-label(
                                  for=`descripcion-img-${img.id}`
                                )
                                  | Descripción

                                textarea.form-control(
                                  name="descripcion"
                                  id=`descripcion-img-${img.id}`
                                  rows="3"
                                  minlength="5"
                                  maxlength="250"
                                  required
                                )

                                .form-text
                                  | Explicá claramente el motivo de la denuncia

                              button.btn.btn-danger(
                                type="submit"
                              )
                                | Denunciar

                          else

                            p.text-muted
                              | Tenés que iniciar sesión para denunciar

                // ======================
                // BOTONES ABAJO
                // ======================
                .mt-3.d-flex.justify-content-center.gap-3

                  button.btn.btn-outline-dark(
                    type="button"
                    data-bs-target=`#carousel-${pub.id}`
                    data-bs-slide="prev"
                  )
                    | ← Anterior

                  button.btn.btn-outline-dark(
                    type="button"
                    data-bs-target=`#carousel-${pub.id}`
                    data-bs-slide="next"
                  )
                    | Siguiente →

            else

              p.text-muted
                | No hay imágenes

    // ======================
    // BOTÓN FLOTANTE
    // ======================
    a.btn.btn-primary.rounded-circle.shadow-lg(
      href="/publicaciones/nueva"
      style="position:fixed; bottom:30px; right:30px; width:70px; height:70px; font-size:35px; display:flex; align-items:center; justify-content:center; z-index:999;"
    )
      | +
    script(src="/js/navbar.js")
    
    #buscadorModal.modal.fade(
      tabindex="-1"
    )

      .modal-dialog

        .modal-content

          .modal-header

            h5.modal-title
              | 🔎 Buscar publicaciones

            button.btn-close(
              type="button"
              data-bs-dismiss="modal"
            )

          .modal-body

            form(
              action="/publicaciones"
              method="GET"
            )

              .mb-3

                label.form-label
                  | Buscar publicaciones, etiquetas o usuarios

                input.form-control(
                  type="text"
                  name="search"
                )

              .mb-3

                label.form-label
                  | Licencia

                select.form-select(
                  name="licencia"
                )

                  option(value="")
                    | Todas

                  option(value="publica")
                    | Publica

                  option(value="copyright")
                    | Copyright

              .mb-3

                label.form-label
                  | Orden

                select.form-select(
                  name="orden"
                )

                  option(value="recientes")
                    | Más recientes

                  option(value="valoradas")
                    | Más valoradas

              button.btn.btn-primary.w-100(
                type="submit"
              )
                | Buscar
    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )