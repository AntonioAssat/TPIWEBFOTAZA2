doctype html
html
  head
    title Publicaciones

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light")

    // ======================
    // NAVBAR
    // ======================
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4
      .container-fluid

        a.navbar-brand(href="/publicaciones")
          | Fotaza

        button.navbar-toggler(
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        )
          span.navbar-toggler-icon

        #navbarNav.collapse.navbar-collapse

          ul.navbar-nav.me-auto

            li.nav-item
              a.nav-link(href="/feed")
                | Feed

            li.nav-item
              a.nav-link(href="/notificaciones")
                | Notificaciones

          if usuario

            ul.navbar-nav

              li.nav-item
                a.nav-link(href=`/perfil/${usuario.id}`)
                  | Mi perfil

    // ======================
    // CONTENIDO
    // ======================
    .container

      h1.mb-4 Publicaciones

      // ======================
      // MENSAJE
      // ======================
      if mensaje
        .alert.alert-success
          = mensaje

      // ======================
      // BUSCADOR
      // ======================
      form(action="/publicaciones" method="GET").mb-4

        .input-group

          input.form-control(
            type="text"
            name="search"
            placeholder="Buscar publicaciones o tags..."
          )

          button.btn.btn-primary(type="submit")
            | Buscar

      // ======================
      // LISTADO
      // ======================
      each pub in publicaciones

        .card.mb-4.shadow-sm

          .card-body

            // ======================
            // TÍTULO
            // ======================
            h2.card-title.mb-3= pub.titulo

            // ======================
            // TAGS
            // ======================
            if pub.Tags && pub.Tags.length > 0

              p

                each tag in pub.Tags

                  span.badge.bg-primary.me-1
                    | ##{tag.nombre}

            // ======================
            // AUTOR
            // ======================
            if pub.User

              p.mb-3
                strong Autor:
                |  

                a(
                  href=`/perfil/${pub.User.id}`
                  class="text-decoration-none"
                )
                  = pub.User.username

            else

              p Autor: Sin usuario

            // ======================
            // IMÁGENES
            // ======================
            if pub.Imagens && pub.Imagens.length > 0

              each img in pub.Imagens

                .border.rounded.p-3.mb-4.bg-white

                  // ======================
                  // IMAGEN
                  // ======================
                  img.img-fluid.rounded.mb-3(
                    src=img.url
                    style="max-width:300px;"
                  )

                  // ======================
                  // DATOS
                  // ======================
                  p
                    strong Licencia:
                    |  #{img.licencia}

                  p
                    strong Estado:
                    |  #{img.estado}

                  if img.watermark
                    p
                      strong Watermark:
                      |  #{img.watermark}

                  // ======================
                  // BLOQUEO
                  // ======================
                  if img.estado == "en_revision"

                    .alert.alert-danger
                      | ⚠ Imagen en revisión (interacciones bloqueadas)

                  else

                    // ======================
                    // COMENTARIOS
                    // ======================
                    h4.mt-4 Comentarios

                    if img.Comentarios && img.Comentarios.length > 0

                      each c in img.Comentarios

                        .border-bottom.pb-2.mb-2

                          p.mb-1
                            = c.texto

                          small.text-muted
                            | por 
                            = c.User.username

                    else

                      p.text-muted Sin comentarios

                    if usuario

                      form(
                        action=`/imagenes/${img.id}/comentario`
                        method="POST"
                        class="mb-4"
                      )

                        .input-group

                          input.form-control(
                            type="text"
                            name="texto"
                            placeholder="Escribí un comentario"
                            required
                          )

                          button.btn.btn-success(type="submit")
                            | Comentar

                    else

                      p.text-muted
                        | Tenés que iniciar sesión para comentar

                    // ======================
                    // VALORACIONES
                    // ======================
                    h4 Valoración

                    if img.Valoracions && img.Valoracions.length > 0

                      p
                        strong Promedio:
                        |  #{img.promedio} ⭐ (
                        = img.Valoracions.length
                        |  votos)

                    else

                      p.text-muted Sin valoraciones

                    if usuario

                      form(
                        action=`/imagenes/${img.id}/valorar`
                        method="POST"
                        class="mb-4"
                      )

                        .row.g-2

                          .col-auto

                            select.form-select(name="valor")

                              option(value="1") 1
                              option(value="2") 2
                              option(value="3") 3
                              option(value="4") 4
                              option(value="5") 5

                          .col-auto

                            button.btn.btn-warning(type="submit")
                              | Valorar

                    else

                      p.text-muted
                        | Tenés que iniciar sesión para valorar

                    // ======================
                    // DENUNCIAS
                    // ======================
                    h4 Denunciar

                    if usuario

                      form(
                        action=`/imagenes/${img.id}/denunciar`
                        method="POST"
                      )

                        .mb-2

                          select.form-select(name="motivo")

                            option(value="Contenido inapropiado")
                              | Contenido inapropiado

                            option(value="Derechos de autor")
                              | Derechos de autor

                            option(value="Spam")
                              | Spam

                        .mb-2

                          input.form-control(
                            type="text"
                            name="descripcion"
                            placeholder="Explicá el motivo"
                          )

                        button.btn.btn-danger(type="submit")
                          | Denunciar

                    else

                      p.text-muted
                        | Tenés que iniciar sesión para denunciar

            else

              p.text-muted No hay imágenes

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )