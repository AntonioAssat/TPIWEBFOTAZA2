doctype html
html
  head
    title Registro

    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    link(
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    )

  body(class="bg-light d-flex align-items-center justify-content-center" style="min-height:100vh;")

    .container

      .row.justify-content-center

        .col-md-6.col-lg-5

          .card.shadow-lg.border-0

            .card-body.p-4

              // ======================
              // TÍTULO
              // ======================
              .text-center.mb-4

                h1.fw-bold Fotaza

                p.text-muted
                  | Creá tu cuenta

              // ======================
              // ALERTA ERROR
              // ======================
              #errorAlert.alert.alert-danger.d-none

              // ======================
              // FORM
              // ======================
              form(action="/registro" method="POST" id="registerForm")

                // USERNAME
                .mb-3

                  label.form-label(for="username")
                    | Usuario

                  input.form-control(
                    type="text"
                    name="username"
                    id="username"
                    placeholder="Elegí un usuario"
                    required
                  )

                // EMAIL
                .mb-3

                  label.form-label(for="email")
                    | Email

                  input.form-control(
                    type="email"
                    name="email"
                    id="email"
                    placeholder="Ingresá tu email"
                    required
                  )

                // PASSWORD
                .mb-3

                  label.form-label(for="password")
                    | Contraseña

                  input.form-control(
                    type="password"
                    name="password"
                    id="password"
                    placeholder="Ingresá una contraseña"
                    required
                  )

                // CONFIRM PASSWORD
                .mb-4

                  label.form-label(for="confirmPassword")
                    | Confirmar contraseña

                  input.form-control(
                    type="password"
                    name="confirmPassword"
                    id="confirmPassword"
                    placeholder="Repetí la contraseña"
                    required
                  )

                // BOTÓN
                .d-grid

                  button.btn.btn-primary.btn-lg(type="submit")
                    | Registrarse

              // ======================
              // LOGIN
              // ======================
              .text-center.mt-4

                p.mb-1.text-muted
                  | ¿Ya tenés cuenta?

                a.text-decoration-none(href="/login")
                  | Iniciá sesión

    // ======================
    // SCRIPT VALIDACIONES
    // ======================
    script(src="/js/registerValidation.js")

    script(
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    )